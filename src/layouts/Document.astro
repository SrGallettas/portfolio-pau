---
import '../styles/global.css';
import '../styles/refinements.css';
import '../styles/content.css';
const { title, description } = Astro.props;
const pageTitle = `${title} · Pau Vila Palop`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImage = Astro.site ? new URL('/work/portfolio/home.png', Astro.site) : undefined;
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="author" content="Pau Vila Palop"/><meta name="robots" content="index, follow"/><meta name="theme-color" content="#f3f4ef"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/>{canonical && <link rel="canonical" href={canonical}/>}<meta property="og:type" content="website"/><meta property="og:locale" content="es_ES"/><meta property="og:site_name" content="Portfolio de Pau Vila Palop"/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/>{canonical && <meta property="og:url" content={canonical}/>} {socialImage && <meta property="og:image" content={socialImage}/>}<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={pageTitle}/><meta name="twitter:description" content={description}/>{socialImage && <meta name="twitter:image" content={socialImage}/>}<title>{pageTitle}</title></head><body>
<a class="skip" href="#contenido">Saltar al contenido</a><header><a class="brand" href="/" aria-label="Pau, inicio">pau<span>.</span></a><nav aria-label="Principal"><a href="/#trabajo">Trabajo</a><a href="/#sobre-mi">Sobre mí</a><a class="nav-contact" href="/#contacto">Hablemos <i data-lucide="arrow-up-right"></i></a></nav></header>
<main id="contenido"><slot/></main><footer><a class="brand" href="/">pau<span>.</span></a><span>DESARROLLO WEB / FRONTEND + BACKEND</span><a href="/#trabajo">Volver al portfolio <i data-lucide="arrow-up-right"></i></a></footer>
<script>
import {createIcons, ArrowUpRight, ArrowLeft, Download, Printer} from 'lucide';
createIcons({icons:{ArrowUpRight,ArrowLeft,Download,Printer}});
document.querySelector('#print-profile')?.addEventListener('click',()=>window.print());
</script>
</body></html>
